+static uint8_t own_danger_active(uint32_t now)
+{
+    uint8_t lv; uint32_t rx;
+    uint32_t pm = __get_PRIMASK(); __disable_irq();
+    lv = own_warn_level; rx = own_warn_rx_ms;
+    __set_PRIMASK(pm);
+    return (lv == 2 && rx != 0 && (now - rx) < OWN_WARN_STALE_MS) ? 1 : 0;
+}
